    echo "Sleep 10s, Press ctrl+c to cancel..."
    Sleep_Sec 10
    local sql_file
    local sql_status
    sql_file=$(mktemp /tmp/lnmp-del-mysql.XXXXXX) || return 1
    cat >"${sql_file}"<<EOF
DROP USER '${database_name}'@'127.0.0.1';
DROP USER '${database_name}'@'localhost';
