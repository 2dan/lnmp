FLUSH PRIVILEGES;
EOF
    ${MySQL_Bin} --defaults-file="${LNMP_MYCNF}" <"${sql_file}"
    sql_status=$?
    rm -f "${sql_file}"
    [ ${sql_status} -eq 0 ] && echo "Delete database: ${database_name} Sucessfully." || echo "Delete database: ${database_name} failed!"
