#!/bin/bash
export PATH=$PATH:/bin:/sbin:/usr/bin:/usr/sbin:/usr/local/bin:/usr/local/sbin:~/bin

# Check if user is root
if [ $(id -u) != "0" ]; then
    echo "Error: You must be root to run this script!"
    exit 1
else
    if env |grep -q SUDO; then
        acme_sh_sudo="-f"
    fi
fi

echo "+-------------------------------------------+"
echo "|    Manager for LNMP, Written by Licess    |"
echo "+-------------------------------------------+"
echo "|       Independent hardened maintenance    |"
echo "+-------------------------------------------+"

PHPFPMPIDFILE=/usr/local/php/var/run/php-fpm.pid

arg1=$1
arg2=$2

Is_Valid_Domain()
{
    local value=$1
    [ ${#value} -le 253 ] && [[ "${value}" =~ ^(\*\.)?([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?\.)+[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$ ]]
}

Validate_Domain_List()
{
    local item
    local domains=()
    read -r -a domains <<< "$1"
    for item in "${domains[@]}"; do
        Is_Valid_Domain "${item}" || return 1
    done
}

Validate_DNS_Provider()
{
    case "$1" in
        ""|cx|ali|cf|dp|he|gd|aws) return 0 ;;
        *) Echo_Red "Unsupported DNS provider."; return 1 ;;
    esac
}

Validate_Web_Root()
{
    local value=$1 resolved
    if [[ -z "${value}" || "${value}" != /* || "${value}" =~ [^/A-Za-z0-9._@+-] ]]; then
        Echo_Red "Website/FTP directory must be an absolute path containing only safe path characters."
        return 1
    fi
    resolved=$(readlink -m -- "${value}" 2>/dev/null) || return 1
    case "${resolved}" in
        /home/wwwroot/*|/var/www/*|/srv/www/*|/data/www/*|/www/wwwroot/*|/usr/local/nginx/html/*) ;;
        *)
            Echo_Red "Refusing unsafe web root: ${resolved}"
            Echo_Red "Use a child directory under /home/wwwroot, /var/www, /srv/www, /data/www, /www/wwwroot, or /usr/local/nginx/html."
            return 1
            ;;
    esac
    VALIDATED_WEB_ROOT=${resolved}
}

Validate_Rewrite_Name()
{
    [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || {
        Echo_Red "Rewrite name contains unsafe characters."
        return 1
    }
}

Validate_Log_Name()
{
    [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$ ]] || {
        Echo_Red "Log filename contains unsafe characters."
        return 1
    }
}

Validate_Certificate_Pair()
{
    local cert=$1 key=$2 cert_pub key_pub
    if [[ "${cert}" != /* || "${key}" != /* || "${cert}" =~ [^/A-Za-z0-9._@+-] || "${key}" =~ [^/A-Za-z0-9._@+-] ||
          ! -f "${cert}" || ! -r "${cert}" || ! -f "${key}" || ! -r "${key}" ]]; then
        Echo_Red "Certificate and key must be readable absolute files with safe path characters."
        return 1
    fi
    openssl x509 -in "${cert}" -noout >/dev/null 2>&1 || {
        Echo_Red "The certificate file is not a valid X.509 certificate."
        return 1
    }
    openssl pkey -in "${key}" -noout >/dev/null 2>&1 || {
        Echo_Red "The private key is invalid or encrypted."
        return 1
    }
    cert_pub=$(openssl x509 -in "${cert}" -pubkey -noout 2>/dev/null | openssl pkey -pubin -outform DER 2>/dev/null | openssl dgst -sha256 2>/dev/null) || return 1
    key_pub=$(openssl pkey -in "${key}" -pubout -outform DER 2>/dev/null | openssl dgst -sha256 2>/dev/null) || return 1
    if [ -z "${cert_pub}" ] || [ "${cert_pub}" != "${key_pub}" ]; then
        Echo_Red "Certificate and private key do not match."
        return 1
    fi
}

Build_ACME_Domain_Args()
{
    local item
    local additional_domains=()
    ACME_DOMAIN_ARGS=(-d "${domain}")
    read -r -a additional_domains <<< "${moredomain}"
    for item in "${additional_domains[@]}"; do
        Is_Valid_Domain "${item}" || return 1
        ACME_DOMAIN_ARGS+=(-d "${item}")
    done
}

lnmp_start()
{
    echo "Starting LNMP..."
    /etc/init.d/nginx start
    /etc/init.d/mysql start
    /etc/init.d/php-fpm start
    for mphpfpm in /etc/init.d/php-fpm7.4 /etc/init.d/php-fpm8.[0-5]
    do
        if [ -f ${mphpfpm} ]; then
            ${mphpfpm} start
        fi
    done
}

lnmp_stop()
{
    echo "Stoping LNMP..."
    /etc/init.d/nginx stop
    /etc/init.d/mysql stop
    /etc/init.d/php-fpm stop
    for mphpfpm in /etc/init.d/php-fpm7.4 /etc/init.d/php-fpm8.[0-5]
    do
        if [ -f ${mphpfpm} ]; then
            ${mphpfpm} stop
        fi
    done
}

lnmp_reload()
{
    echo "Reload LNMP..."
    /etc/init.d/nginx reload
    /etc/init.d/mysql reload
    /etc/init.d/php-fpm reload
    for mphpfpm in /etc/init.d/php-fpm7.4 /etc/init.d/php-fpm8.[0-5]
    do
        if [ -f ${mphpfpm} ]; then
            ${mphpfpm} reload
        fi
    done
}

lnmp_kill()
{
    echo "Kill nginx,php-fpm,mysql process..."
    killall nginx
    killall mysqld
    killall php-fpm
    killall php-cgi
    echo "done."
}

lnmp_status()
{
    /etc/init.d/nginx status
    if [ -f $PHPFPMPIDFILE ]; then
        echo "php-fpm is runing!"
    else
        echo "php-fpm is stop!"
    fi
    /etc/init.d/mysql status
}

