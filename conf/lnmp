Edit_Database()
{
    while :;do
        Echo_Yellow "Enter database username: "
        read database_username
        if ! echo "${database_username}" | grep -Eq '^[A-Za-z0-9_]{1,32}$'; then
            Echo_Red "Database username must contain only letters, numbers, and underscores (maximum 32 characters)."
        else
            break
        fi
    done
    while :;do
        Echo_Yellow "Enter NEW Password: "
        read -r -s database_username_passwd
        echo
        if [ "${database_username_passwd}" == "" ]; then
            Echo_Red "Database Password can't be empty!"
        else
            break
        fi
    done

    local database_password_sql=${database_username_passwd//\\/\\\\}
    database_password_sql=${database_password_sql//\'/\'\'}

    if echo "${MySQL_Ver}" | grep -Eqi '^5.7.';then
        Do_Query "UPDATE mysql.user SET authentication_string=PASSWORD('${database_password_sql}') WHERE User='${database_username}' AND Host IN ('localhost', '127.0.0.1', '::1');"
    elif echo "${MySQL_Ver}" | grep -Eqi '^8\.';then
        Do_Query "ALTER USER '${database_username}'@'127.0.0.1' IDENTIFIED BY '${database_password_sql}';"
        Do_Query "ALTER USER '${database_username}'@'localhost' IDENTIFIED BY '${database_password_sql}';"
    else
        Do_Query "UPDATE mysql.user SET Password=PASSWORD('${database_password_sql}') WHERE User='${database_username}' AND Host IN ('localhost', '127.0.0.1', '::1');"
    fi
    [ $? -eq 0 ] && echo "Edit user password Sucessfully." || echo "Edit user password databases failed!"
    Do_Query "FLUSH PRIVILEGES;"
}

